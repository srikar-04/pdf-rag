generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  GOOGLE
  GITHUB
}

enum DocStatus {
  processing
  Ingesting
  ready
  failed
}

enum IngestionStep {
  none
  fetched
  normalized
  chunked
  embedded
  upserted
}

enum ChatStatus {
  empty
  active
}

enum Role {
  user
  assistant
  system
  dev
}

enum EmbeddingStatus {
  none
  ready
  failed
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  provider       Provider 
  providerUserId String   
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  chats          Chat[]
  docs           Document[]
  deletedAt      DateTime?
  @@unique([provider, providerUserId])
}

model Chat {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  title  String
  chatStatus ChatStatus @default(empty)
  documents         ChatDocument[]
  messages Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id              String  @id @default(uuid())
  documentName    String
  storagePath    String
  chats         ChatDocument[]
  userId          String
  user            User    @relation(fields: [userId], references: [id])
  documentStatus  DocStatus
  ingestionStep   IngestionStep @default(none)
  chunks          ChunkHash[]
  documentHash    String   @unique

}

model ChatDocument {
  chatId     String
  documentId String
  chat       Chat     @relation(fields: [chatId], references: [id])
  document   Document @relation(fields: [documentId], references: [id])

  @@id([chatId, documentId])
}

model Message {
  id          String @id @default(uuid())
  chatId      String
  chat        Chat @relation(fields: [chatId], references: [id])
  content     String
  role        Role
  createdAt   DateTime @default(now())
}

model ChunkHash {
  id            String @id @default(uuid())
  documentId    String 
  doc           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkHash     String 
  chunkIndex    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contentLenght Int
  embeddingStatus EmbeddingStatus @default(none)
  @@unique([documentId, chunkHash])
}